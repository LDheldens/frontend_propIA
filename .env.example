# Example environment variables for frontend_propIA
# Copy this file to `.env` and fill real values for your environment.

# Base URL for the API (no trailing slash recommended)
VITE_API_URL=http://127.0.0.1:8002/api/

# Base URL for images/media (can include trailing slash)
VITE_URL_IMG=http://127.0.0.1:8002/media/
